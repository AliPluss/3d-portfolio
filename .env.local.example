# ── Next.js (frontend) ──────────────────────────────────────────────────────
# URL of the Express backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Express backend  (copy these to server/.env) ────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_string
REGISTER_SECRET=replace_with_a_secret_to_protect_the_register_endpoint

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── PostHog analytics (optional — leave blank to disable) ───────────────────
# Get your key from app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
